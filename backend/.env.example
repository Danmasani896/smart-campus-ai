# REQUIRED: local SQLite URL; relative to prisma/schema.prisma
DATABASE_URL="file:./campus.db"
# REQUIRED: generate a random secret of at least 32 characters; never share it
JWT_SECRET=""
# Local server settings
PORT=4000
# Leave empty to answer on localhost, 127.0.0.1 and ::1. Set e.g. 127.0.0.1 to pin one interface.
HOST=""
# Browser origins allowed to call the API directly (comma-separated). The Next.js /api proxy does not need this.
FRONTEND_ORIGIN="http://localhost:3000,http://127.0.0.1:3000"
INSTITUTION_ID="buk"
NODE_ENV="development"
# OPTIONAL: leave blank for grounded extractive answers without paid AI
OPENAI_API_KEY=""
# REQUIRED only when OPENAI_API_KEY is set: a Responses-compatible model your account can access
OPENAI_MODEL=""
# Personal extracted documents expire automatically (hours, 1–168)
DOCUMENT_RETENTION_HOURS=24
# One-time admin bootstrap only. Set before npm run admin:create, then remove password.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Campus Administrator"

# -----------------------------------------------------------------------------
# SETUP COMMANDS (run from the project root unless noted)
# -----------------------------------------------------------------------------
# Install all dependencies (backend + frontend):
#   npm run install:all
#
# Generate the Prisma client:
#   npm run db:generate --prefix backend
#
# Run database migrations:
#   npm run db:migrate --prefix backend
#
# Start the backend dev server (http://localhost:4000):
#   npm run dev:backend
#
# Start the frontend dev server (http://localhost:3000):
#   npm run dev:frontend
#
# Create the admin account (reads ADMIN_EMAIL/ADMIN_PASSWORD/ADMIN_NAME above):
#   npm run admin:create --prefix backend
#
# Seed sample content:
#   npm run db:seed --prefix backend
#
# Import content documents:
#   npm run content:import --prefix backend
#
# Build both apps for production:
#   npm run build
#
# Run backend tests:
#   npm test --prefix backend
#
# Typecheck both apps:
#   npm run typecheck

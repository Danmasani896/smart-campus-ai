{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:backend"],
      "port": 4000,
      "url": "http://localhost:4000"
    },
    {
      "name": "backend-nowatch",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "backend"],
      "port": 4000,
      "url": "http://localhost:4000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:frontend"],
      "port": 3000,
      "url": "http://localhost:3000"
    },
    {
      "name": "frontend-3001",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev", "--prefix", "frontend", "--", "-p", "3001"],
      "port": 3001,
      "url": "http://localhost:3001"
    }
  ]
}

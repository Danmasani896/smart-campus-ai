# API base the browser calls. "/api" is proxied by Next.js to API_PROXY_TARGET (same origin, no CORS).
# Use an absolute URL only if the backend is served on its own host, e.g. https://api.example.edu/api.
NEXT_PUBLIC_API_URL="/api"
# Server-side only: where Next.js forwards /api requests.
API_PROXY_TARGET="http://127.0.0.1:4000"
# OPTIONAL: no map API key is needed for development OpenStreetMap tiles.
# Mapbox (raster tiles, works with the existing Leaflet map; token is public so restrict it to your domain in Mapbox):
# NEXT_PUBLIC_MAP_TILE_URL="https://api.mapbox.com/styles/v1/mapbox/streets-v12/tiles/256/{z}/{x}/{y}?access_token=pk.YOUR_PUBLIC_TOKEN"
# NEXT_PUBLIC_MAP_ATTRIBUTION="© Mapbox © OpenStreetMap contributors"
NEXT_PUBLIC_MAP_TILE_URL="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
# Required attribution for your chosen tile provider. Plain text.
NEXT_PUBLIC_MAP_ATTRIBUTION="© OpenStreetMap contributors"
# Map engine: "google" (default when a key exists; browser key works without billing), "mapbox", or
# "osm" (Leaflet fallback, no key). Mapbox token also powers walking routes. Keys are browser-visible;
# restrict them to your domains in the Mapbox / Google consoles.
NEXT_PUBLIC_MAP_PROVIDER="google"
NEXT_PUBLIC_MAPBOX_TOKEN=""
NEXT_PUBLIC_GOOGLE_MAPS_KEY=""

